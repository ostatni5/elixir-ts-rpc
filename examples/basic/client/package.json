{
  "name": "@examples/basic-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "rpc:gen": "cd ../server && mix rpc.gen.ts --router BasicServer.Router --out ../client/src/rpc.gen.ts",
    "rpc:gen:watch": "cd ../server && mix rpc.gen.ts.watch --router BasicServer.Router --out ../client/src/rpc.gen.ts"
  },
  "dependencies": {
    "@elixir-ts-rpc/client": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.10"
  }
}
